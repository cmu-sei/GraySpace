{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "GraySpace": {
    // simulated: no Proxmox. The API reports every guest of the topology as running (a simulated
    //   deployment), and Prometheus scrapes simulated router metrics, so the map, link states
    //   and the slice views all work locally.
    // deployment: the API against a real deployment, with the settings of .environment (reach it
    //   with task tunnel). Slice jobs run from this checkout.
    "Mode": "simulated",
    // The topology the simulated deployment shows: a tfvars file, relative to the repository.
    // Empty: terraform/terraform.tfvars.json if task parse made one, else tests/golden/tfvars-full.json.
    "Tfvars": "",
    // deployment mode: the deployment's Prometheus, e.g. http://10.0.1.20:9090 (empty: asked for in the dashboard)
    "PrometheusUrl": "",
    "Docs": true,
    "Ports": {
      "Api": 8000,
      "Ui": 3000,
      "Prometheus": 9090,
      "RouterMetrics": 9342,
      "Docs": 8001
    }
  }
}

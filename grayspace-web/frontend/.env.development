# npm start only. The development server claims /ws for its own hot reload, so the app's
# websockets (/ws, /ws/console, /ws/desktop, /api/v1/events) go to the backend directly, and
# src/setupProxy.js forwards the plain HTTP /api requests. The Aspire AppHost sets both.
REACT_APP_WS_URL=ws://localhost:8000
BROWSER=none

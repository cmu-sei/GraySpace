#!/bin/sh
# Edge networking for slice site {{ edge.site }}. Written by GraySpace; safe to run again.
sysctl -q -w net.ipv4.ip_forward=1
{% for p in edge.published %}
ip addr replace {{ p.public_ip }}/{{ edge.wans[0].prefixlen }} dev {{ edge.wans[0].interface }}
{% endfor %}
iptables-restore < /etc/iptables/grayspace.rules

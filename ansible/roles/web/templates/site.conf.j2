# Written by GraySpace (web role).
server {
    listen 80 default_server;
    server_name _;
    root /var/www/html;
    index index.html;
}
{% if web_tls %}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/ssl/grayspace/host.crt;
    ssl_certificate_key /etc/ssl/grayspace/host.key;
    root /var/www/html;
    index index.html;
}
{% endif %}

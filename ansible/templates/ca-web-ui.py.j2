def run_step(args, input_data=None):
    """Run a step CLI command and return stdout."""
    env = os.environ.copy()
    env["STEPPATH"] = STEPPATH
    result = subprocess.run(
        args, capture_output=True, text=True, env=env, input=input_data
    )
    return result


@app.route("/")
def index():
    return render_template_string(HTML_TEMPLATE)


@app.route("/api/root")
def get_root_cert():
    try:
        with open(ROOT_CERT, "r") as f:
            return f.read(), 200, {"Content-Type": "application/x-pem-file",
                                   "Content-Disposition": "attachment; filename=root_ca.crt"}
    except FileNotFoundError:
        return jsonify({"error": "Root certificate not found"}), 500


def _load_certs_db():
    """Load the issued certificates database."""
    try:
        with open(CERTS_DB, "r") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


def _save_certs_db(certs):
    """Save the issued certificates database."""
    with open(CERTS_DB, "w") as f:
        json.dump(certs, f, indent=2)


def _parse_cert_info(cert_pem):
    """Extract serial, not_before, not_after from a PEM certificate."""
    with tempfile.NamedTemporaryFile(mode="w", suffix=".crt", delete=False) as f:
        f.write(cert_pem)
        tmp_path = f.name
    try:
        result = subprocess.run(
            ["openssl", "x509", "-in", tmp_path, "-noout",
             "-serial", "-startdate", "-enddate"],
            capture_output=True, text=True
        )
        info = {}
        for line in result.stdout.strip().split("\n"):
            if line.startswith("serial="):
                info["serial"] = line.split("=", 1)[1]
            elif line.startswith("notBefore="):
                info["not_before"] = line.split("=", 1)[1]
            elif line.startswith("notAfter="):
                info["not_after"] = line.split("=", 1)[1]
        return info
    finally:
        os.unlink(tmp_path)


@app.route("/api/issue", methods=["POST"])
def issue_certificate():
    data = request.get_json()
    domain = data.get("domain", "").strip()
    if not domain:
        return jsonify({"success": False, "error": "Domain is required"}), 400
    # Optional: more names (subject alternative names) and a validity such as "720h". Slices ask
    # for longer than the UI's default, up to the CA's maximum (ansible/main.yml sets 2160h).
    sans = [s.strip() for s in data.get("sans") or [] if isinstance(s, str) and s.strip()]
    not_after = str(data.get("not_after") or "24h")
    name_ok = re.compile(r"^(\*\.)?[A-Za-z0-9_.-]+$")
    if not all(name_ok.match(n) for n in [domain] + sans) or not re.fullmatch(r"[0-9]{1,5}h", not_after):
        return jsonify({"success": False, "error": "Invalid domain, sans or not_after"}), 400

    with tempfile.NamedTemporaryFile(mode="w", suffix=".crt", delete=False) as cert_file, \
         tempfile.NamedTemporaryFile(mode="w", suffix=".key", delete=False) as key_file:
        cert_path = cert_file.name
        key_path = key_file.name

    try:
        result = run_step([
            "step", "ca", "certificate",
            domain, cert_path, key_path,
            "--provisioner", "admin",
            "--provisioner-password-file", PASSWORD_FILE,
            "--ca-url", CA_URL,
            "--root", ROOT_CERT,
            "--not-after", not_after,
            "--force",
        ] + [arg for name in ([domain] + sans if sans else []) for arg in ("--san", name)])

        if result.returncode != 0:
            return jsonify({"success": False, "error": result.stderr.strip()}), 500

        with open(cert_path, "r") as f:
            cert_pem = f.read()
        with open(key_path, "r") as f:
            key_pem = f.read()

        # Track the issued certificate
        cert_info = _parse_cert_info(cert_pem)
        certs = _load_certs_db()
        certs.append({
            "serial": cert_info.get("serial", "unknown"),
            "subject": domain,
            "not_before": cert_info.get("not_before", ""),
            "not_after": cert_info.get("not_after", ""),
            "status": "active",
        })
        _save_certs_db(certs)

        return jsonify({
            "success": True,
            "certificate": cert_pem,
            "private_key": key_pem,
            "domain": domain,
        })
    finally:
        os.unlink(cert_path)
        os.unlink(key_path)


@app.route("/api/certificates")
def list_certificates():
    certs = _load_certs_db()
    return jsonify({"certificates": certs})


@app.route("/api/revoke", methods=["POST"])
def revoke_certificate():
    data = request.get_json()
    serial = data.get("serial", "").strip()
    if not serial:
        return jsonify({"success": False, "error": "Serial number is required"}), 400

    result = run_step([
        "step", "ca", "revoke",
        serial,
        "--provisioner", "admin",
        "--provisioner-password-file", PASSWORD_FILE,
        "--ca-url", CA_URL,
        "--root", ROOT_CERT,
    ])

    if result.returncode != 0:
        return jsonify({"success": False, "error": result.stderr.strip()}), 500

    # Update status in tracking DB
    certs = _load_certs_db()
    for cert in certs:
        if cert.get("serial") == serial:
            cert["status"] = "revoked"
    _save_certs_db(certs)

    return jsonify({"success": True, "message": f"Certificate {serial} revoked"})


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=80)

#!/usr/bin/env python3
"""{{ ca_name }} Certificate Authority - Web UI

Simple web interface for requesting and managing SSL certificates.
Communicates with the local step-ca instance via CLI.
"""
import json
import os
import re
import subprocess
import tempfile
from flask import Flask, request, jsonify, render_template_string

app = Flask(__name__)


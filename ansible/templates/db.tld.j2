; Zone file for {{ item }} TLD
; Managed by Ansible — do not edit manually
$TTL 86400
@   IN  SOA ns1.{{ item }}. admin.{{ item }}. (
        2024010101  ; serial
        3600        ; refresh
        900         ; retry
        604800      ; expire
        86400       ; minimum TTL
)

; Authoritative nameserver
@   IN  NS  ns1.{{ item }}.
ns1.{{ item }}.  IN  A   {{ service_ip }}

; Domains created at runtime (grayspace-web dns_service): their NS and glue records live in a
; file Ansible creates once and never overwrites, so re-running this template keeps them.
$INCLUDE /var/bind/delegations.{{ item }}

[Unit]
Description=The desktop session (Fluxbox, pcmanfm's desktop icons, tint2)
After=xvfb.service
BindsTo=xvfb.service

[Service]
User=user
WorkingDirectory=~
Environment=DISPLAY=:0 LANG=C.UTF-8 XDG_RUNTIME_DIR=/run/desktop
RuntimeDirectory=desktop
RuntimeDirectoryMode=0700
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X0 ]; do sleep 0.2; done'
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/startfluxbox
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
